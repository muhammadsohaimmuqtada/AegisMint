{
  "name": "aegismint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "deploy:preflight": "hardhat run scripts/preflight.ts --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat verify",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "abi:export": "node scripts/export-abis.mjs",
    "check": "npm run compile && npm test && npm run abi:export && npm run web:build",
    "install:all": "npm ci && npm --prefix web ci"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "hardhat": "3.12.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
