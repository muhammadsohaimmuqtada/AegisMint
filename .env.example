# Hardhat / Sepolia (NEVER commit real secrets)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Marketplace deployment
MARKETPLACE_FEE_BPS=250

# Frontend public configuration
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PINATA_GATEWAY=your-gateway.mypinata.cloud

# Server-only Pinata secret (Vercel environment variable; never NEXT_PUBLIC_*)
PINATA_JWT=YOUR_PINATA_JWT

# Set this after Sepolia deployment so provenance queries do not scan from genesis.
NEXT_PUBLIC_DEPLOYMENT_BLOCK=0
